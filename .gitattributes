# .gitattributes — что НЕ попадает на хостинг.
#
# Деплой (.github/workflows/deploy.yml) собирает дерево командой
#   git archive HEAD
# Поэтому export-ignore здесь — единственный надёжный фильтр: в вебрут уходят
# только файлы сайта из индекса git, а локальные артефакты (дампы заявок,
# слепки хостинга, кэши, node_modules) не выгружаются в принципе — их нет в git.

# --- Инфраструктура, документация, инструменты разработчика ---
/.gitattributes    export-ignore
/.gitignore        export-ignore
/.github/**        export-ignore
/.clinerules       export-ignore
/tests/**          export-ignore
/.tools/**         export-ignore
*.md               export-ignore
*.bat              export-ignore
*.ps1              export-ignore
*.py               export-ignore

# --- Исходники SSG блога ---
# Статьи и шаблон нужны только на этапе сборки: в blog/{slug}.php шаблон уже
# встроен, поэтому на хостинге не нужны ни content/, ни templates/.
# Маски с /** обязательны: каталоговые шаблоны в .gitattributes не рекурсивны.
/content/**        export-ignore
/templates/**      export-ignore

