# Сайт статический на PHP — Node.js/Next.js в проекте больше не используются.
# Здесь только правила для локальных артефактов и файлов с ПДн.

# зависимости и артефакты сборки (на случай локальных JS-инструментов)
/node_modules/
/build/

# окружение и логи
.env*.local
npm-debug.log*
yarn-debug.log*
yarn-error.log*

# ОС и архивы
.DS_Store
Thumbs.db
*.zip
*.pem

# заявки с ПДн — хранятся вне вебрута и вне git
requests.txt
requests.json

# local tooling (portable PHP и прочие локальные утилиты)
/.tools/

# python
__pycache__/
*.pyc
